node_modules/
dist/
*.tsbuildinfo
*.log
Temp/
.DS_Store

# Generated mod projects (regenerate from the spec; never edit them by hand).
out/

# Toolchains downloaded for build verification (Gradle distributions, JDKs).
.tools/

# Local image-provider credentials, when kept in a file rather than the environment.
.env
.env.*

# Scratch space for compile-verification runs (generated projects + downloaded probe jars).
# These are dot-prefixed and transient; a stray `git add -A` should never pick them up.
.scratch/
.probe/
# Per-version probe dirs (.probe116, .probe-1.12, ...) - same rules, named per target.
.probe*/
