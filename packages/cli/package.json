{
  "name": "@mcmodkit/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "mcmodkit CLI: scaffold/validate/generate Minecraft mods for agents and humans",
  "bin": {
    "mcmod": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@mcmodkit/adapters": "workspace:*",
    "@mcmodkit/core": "workspace:*",
    "commander": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*"
  }
}
