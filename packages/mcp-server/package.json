{
  "name": "@mcmodkit/mcp-server",
  "version": "0.1.0",
  "type": "module",
  "description": "mcmodkit MCP server: exposes the mod-generation workflow as MCP tools",
  "bin": {
    "mcmodkit-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
