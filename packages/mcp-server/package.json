    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mcmodkit/adapters": "workspace:*",
    "@mcmodkit/core": "workspace:*",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "vitest": "*",
    "@types/node": "*"
  }
}
